# ── Storage: choose ONE mode ──────────────────────────────────────────────

# MODE A: MinIO (local dev — matches docker-compose defaults)
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=rag-docs
AWS_REGION=us-east-1

# MODE B: Real AWS S3 (production)
# Comment out the four MinIO lines above and fill these in instead:
# S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=your-confluence-bucket
# AWS_REGION=us-east-1

# ── MinIO admin credentials (must match docker-compose) ───────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── Qdrant (defaults work if using docker-compose) ────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
COLLECTION_NAME=confluence_docs

# ── Ollama (defaults work if using docker-compose) ────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Chunking ──────────────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50
